# Proveedor del modelo: anthropic | guion (guion = sin modelo, determinista, para demo/CI)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modelos por agente (Anthropic). Opus solo como escalamiento opcional del operador.
LLM_MODELO_ROUTER=claude-haiku-5-5
LLM_MODELO_OPERADOR=claude-sonnet-5-5
LLM_MODELO_ASESOR=claude-haiku-5-5
LLM_MODELO_CONVERSADOR=claude-haiku-5-5
# Límites de costo
AGENT_MAX_ITERACIONES=25
AGENT_MAX_TOKENS_SESION=300000
LLM_TIMEOUT_MS=60000
# Servidor
PORT=8080
# Opcional: carpeta de salida (por defecto ./out)
OUT_DIR=
# Autenticación (obligatoria). cognito | local. "abierto" solo se acepta fuera de producción.
AUTH_MODO=local
# Modo local (desarrollo): usuario y clave de prueba
AUTH_USUARIO=evaluador@periferia-ficticia.com
AUTH_CLAVE=
AUTH_SECRETO=
# Modo cognito (producción)
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Presupuesto global de gasto en IA (USD)
PRESUPUESTO_USD=10
