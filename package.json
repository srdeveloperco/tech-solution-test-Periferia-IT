{
  "name": "oc-agente-sap",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "build": "bun run --filter @oc/web build",
    "start": "bun apps/api/src/main.ts",
    "demo": "bun run demo.ts",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "modulo:build": "bun scripts/modulo.ts",
    "modulo:check": "bun scripts/modulo.ts --check",
    "verify": "bun run lint && bun run typecheck && bun test && bun run demo.ts && bun run modulo:check",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "latest",
    "lefthook": "2.2.2",
    "typescript": "7.0.2"
  }
}
